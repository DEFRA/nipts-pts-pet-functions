{
  "openapi": "3.0.1",
  "info": {
    "title": "PTS Pet Functions API",
    "description": "Pet Travel Scheme - Pet Functions API",
    "version": "v1"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["HealthCheck"],
        "operationId": "HealthCheck",
        "summary": "Health Check",
        "description": "Checks the health of the service and database connectivity.",
        "responses": {
          "200": { "description": "Healthy" },
          "503": { "description": "Service Unavailable" }
        }
      }
    },
    "/microchip/{microchipnumber}": {
      "get": {
        "tags": ["Pet"],
        "operationId": "CheckMicrochip",
        "summary": "Check Microchip",
        "description": "Check Microchip by Microchip number.",
        "parameters": [
          {
            "name": "microchipnumber",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": { "type": "string" }
              }
            }
          },
          "400": { "description": "Bad Request - Microchip number is required" }
        }
      }
    },
    "/createpet": {
      "post": {
        "tags": ["Pet"],
        "operationId": "CreatePet",
        "summary": "Create Pet",
        "description": "Create a Pet entry by Pet details.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PetViewModel" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "type": "string", "format": "uuid" }
              }
            }
          },
          "400": { "description": "Bad Request - Invalid input or malformed JSON" }
        }
      }
    },
    "/breed/{speciesId}": {
      "get": {
        "tags": ["Breed"],
        "operationId": "GetBreed",
        "summary": "Get Breeds",
        "description": "Get Breeds by Species ID.",
        "parameters": [
          {
            "name": "speciesId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/BreedEntity" }
                }
              }
            }
          },
          "400": { "description": "Bad Request - Invalid speciesId" },
          "404": { "description": "Not Found - No breeds for species" }
        }
      }
    },
    "/colour/{speciesId}": {
      "get": {
        "tags": ["Breed"],
        "operationId": "GetColours",
        "summary": "Get Colours",
        "description": "Get Colours by Species ID.",
        "parameters": [
          {
            "name": "speciesId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32" }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ColourEntity" }
                }
              }
            }
          },
          "400": { "description": "Bad Request - Invalid speciesId" },
          "404": { "description": "Not Found - No colours for species" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PetViewModel": {
        "type": "object",
        "properties": {
          "createdBy": { "type": "string", "format": "uuid", "nullable": true },
          "petIdentification": { "$ref": "#/components/schemas/PetIdentificationViewModel" },
          "petMicrochipDate": { "$ref": "#/components/schemas/PetMicrochipDateViewModel" },
          "petSpecies": { "$ref": "#/components/schemas/PetSpeciesViewModel" },
          "petBreed": { "$ref": "#/components/schemas/PetBreedViewModel" },
          "petName": { "$ref": "#/components/schemas/PetNameViewModel" },
          "petGender": { "$ref": "#/components/schemas/PetGenderViewModel" },
          "petAge": { "$ref": "#/components/schemas/PetAgeViewModel" },
          "petColour": { "$ref": "#/components/schemas/PetColourViewModel" },
          "petFeature": { "$ref": "#/components/schemas/PetFeatureViewModel" },
          "petMicrochip": { "$ref": "#/components/schemas/PetMicrochipViewModel" }
        }
      },
      "PetIdentificationViewModel": { "type": "object" },
      "PetMicrochipDateViewModel": { "type": "object" },
      "PetSpeciesViewModel": { "type": "object" },
      "PetBreedViewModel": { "type": "object" },
      "PetNameViewModel": { "type": "object" },
      "PetGenderViewModel": { "type": "object" },
      "PetAgeViewModel": { "type": "object" },
      "PetColourViewModel": { "type": "object" },
      "PetFeatureViewModel": { "type": "object" },
      "PetMicrochipViewModel": { "type": "object" },
      "BreedEntity": { "type": "object" },
      "ColourEntity": { "type": "object" }
    }
  }
}
